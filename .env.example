PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=<generate-a-strong-random-secret-min-32-chars>
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Server-side Gemini key used for Product Link URL Context extraction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Server-side only. Copy the CLOUDINARY_URL from your Cloudinary dashboard.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Resend contact-form delivery. RESEND_FROM must be a verified Resend sender in production.
RESEND_API_KEY=re_<your_resend_api_key>
RESEND_FROM=Industry Mandi <onboarding@resend.dev>
# In Resend test mode this must be the email address of the Resend account owner.
CONTACT_RECIPIENT=bishwajeetsingh355@gmail.com
